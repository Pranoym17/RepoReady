{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoReady",
  "version": "0.1.0-alpha.1",
  "identifier": "org.repoready.development",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "features": ["desktop"]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RepoReady",
        "width": 1000,
        "height": 700,
        "minWidth": 320,
        "minHeight": 480,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "requireSignedVersion": true,
      "windows": { "installMode": "basicUi" }
    }
  },
  "bundle": {
    "active": false
  }
}
