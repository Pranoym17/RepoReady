{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoReady Development",
  "version": "0.0.0",
  "identifier": "org.repoready.development",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "features": ["desktop"]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RepoReady Development",
        "width": 1000,
        "height": 700
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
