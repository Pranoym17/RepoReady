{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoReady Development",
  "version": "0.1.0-alpha.1",
  "identifier": "org.repoready.development",
  "build": {
    "beforeBuildCommand": "node src-tauri/packaging/check-profile.mjs development && npm run build"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": false },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "RepoReady Development",
        "languages": ["English"],
        "installerHooks": "./packaging/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": { "installMode": "basicUi" }
    }
  }
}
