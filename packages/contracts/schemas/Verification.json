{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "appId": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "testDate": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z))$"
    },
    "tester": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "testMatrixId": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "checklistVersion": {
      "type": "string",
      "const": "beta-1"
    },
    "licenseReview": {
      "type": "string",
      "const": "passed"
    },
    "securityReview": {
      "type": "string",
      "const": "passed"
    },
    "coreTaskResult": {
      "type": "string",
      "const": "passed"
    },
    "lifecycleResult": {
      "type": "string",
      "const": "passed"
    },
    "evidenceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "appId",
    "version",
    "artifactSha256",
    "testDate",
    "tester",
    "testMatrixId",
    "checklistVersion",
    "licenseReview",
    "securityReview",
    "coreTaskResult",
    "lifecycleResult",
    "evidenceSha256"
  ],
  "additionalProperties": false
}
