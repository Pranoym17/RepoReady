{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "development",
        "stable"
      ]
    },
    "catalog": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not-configured",
            "fresh",
            "stale",
            "offline",
            "error"
          ]
        },
        "issuedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastVerifiedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sequence": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "slug": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "category": {
                "type": "string",
                "enum": [
                  "ai",
                  "productivity",
                  "media",
                  "utilities"
                ]
              },
              "tags": {
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50
                }
              },
              "sourceUrl": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^https:\\/\\/github\\.com\\/[A-Za-z0-9-]+\\/[A-Za-z0-9_.-]+$"
              },
              "upstreamAuthor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "licenseSpdx": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "status": {
                "type": "string",
                "enum": [
                  "ready",
                  "publisher-installer",
                  "requested",
                  "unavailable",
                  "paused",
                  "revoked"
                ]
              },
              "screenshots": {
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^https:\\/\\/[a-zA-Z0-9.-]+(?::443)?(?:\\/[^\\s#]*)?$"
                }
              },
              "requirements": {
                "type": "object",
                "properties": {
                  "minWindowsBuild": {
                    "type": "integer",
                    "minimum": 22000,
                    "maximum": 999999
                  },
                  "minRamMb": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1048576
                  },
                  "diskMb": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 16777216
                  },
                  "gpuNotes": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "internetRequired": {
                    "type": "boolean"
                  },
                  "externalApiProviders": {
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 80,
                      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                    }
                  },
                  "apiChargesDisclosed": {
                    "type": "boolean"
                  },
                  "extraDownloadBytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "minWindowsBuild",
                  "minRamMb",
                  "diskMb",
                  "gpuNotes",
                  "internetRequired",
                  "externalApiProviders",
                  "apiChargesDisclosed",
                  "extraDownloadBytes"
                ],
                "additionalProperties": false
              },
              "verifiedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "supportUrl": {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^https:\\/\\/[a-zA-Z0-9.-]+(?::443)?(?:\\/[^\\s#]*)?$"
              }
            },
            "required": [
              "id",
              "slug",
              "name",
              "summary",
              "description",
              "category",
              "tags",
              "sourceUrl",
              "upstreamAuthor",
              "licenseSpdx",
              "status",
              "screenshots",
              "requirements",
              "verifiedAt",
              "supportUrl"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "issuedAt",
        "expiresAt",
        "lastVerifiedAt",
        "sequence",
        "items"
      ],
      "additionalProperties": false
    },
    "library": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "appId": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
          },
          "installedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z))$"
          },
          "lastLaunchAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "updateStatus": {
            "type": "string",
            "enum": [
              "unknown",
              "current",
              "available",
              "held"
            ]
          },
          "sourceSummary": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": [
          "appId",
          "version",
          "installedAt",
          "lastLaunchAt",
          "updateStatus",
          "sourceSummary"
        ],
        "additionalProperties": false
      }
    },
    "preferences": {
      "type": "object",
      "properties": {
        "cacheLimitMb": {
          "type": "integer",
          "minimum": 16,
          "maximum": 512
        },
        "logRetentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      },
      "required": [
        "cacheLimitMb",
        "logRetentionDays"
      ],
      "additionalProperties": false
    },
    "recoveryRequired": {
      "type": "boolean"
    },
    "update": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not-configured",
            "current",
            "available",
            "checking",
            "downloaded",
            "failed",
            "restart-required"
          ]
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80,
              "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "messageCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      },
      "required": [
        "status",
        "version",
        "messageCode"
      ],
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "logBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "logBytes"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "manageApps": {
          "type": "boolean",
          "const": false
        },
        "requests": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "manageApps",
        "requests"
      ],
      "additionalProperties": false
    },
    "lastError": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_INPUT",
                "NOT_AVAILABLE",
                "UNTRUSTED_CATALOG",
                "STALE_CATALOG",
                "INCOMPATIBLE",
                "INSUFFICIENT_DISK",
                "DOWNLOAD_FAILED",
                "HASH_MISMATCH",
                "INSTALL_FAILED",
                "RECOVERY_REQUIRED",
                "CREDENTIAL_FAILED",
                "RATE_LIMITED",
                "INTERNAL_ERROR"
              ]
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "retryable"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "mode",
    "catalog",
    "library",
    "preferences",
    "recoveryRequired",
    "update",
    "diagnostics",
    "capabilities",
    "lastError"
  ],
  "additionalProperties": false
}
