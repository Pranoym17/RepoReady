{
  "name": "repoready",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "24.16.x",
    "npm": "11.13.x"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm run dev -w @repoready/desktop",
    "dev:web": "npm run dev -w @repoready/web",
    "dev:requests": "npm run dev -w @repoready/requests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "tsx --test packages/contracts/test/*.test.ts packages/catalog-tools/test/*.test.ts services/requests/test/*.test.ts tests/*.test.ts apps/desktop/src-tauri/packaging/*.test.mjs",
    "build": "npm run build --workspaces --if-present",
    "schemas:generate": "tsx packages/contracts/scripts/generate.ts",
    "schemas:check": "tsx packages/contracts/scripts/generate.ts --check",
    "policy:check": "node scripts/check-policy.mjs",
    "catalog:lint": "tsx packages/catalog-tools/src/lint-cli.ts",
    "web:static": "node scripts/check-web.mjs",
    "web:eval": "playwright test",
    "desktop:eval": "playwright test --config playwright.desktop.config.ts",
    "client:acceptance": "node apps/desktop/src-tauri/packaging/acceptance.mjs",
    "client:preflight": "powershell -NoProfile -File scripts/windows-preflight.ps1",
    "client:private-build": "powershell -NoProfile -File scripts/build-private-client.ps1",
    "client:sign-policy": "tsx packages/catalog-tools/scripts/sign-client-policy.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run schemas:check && npm test && npm run policy:check && npm run catalog:lint && npm run build && npm run web:static"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "cheerio": "1.2.0",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
